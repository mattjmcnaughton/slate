LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data.db
# Production: postgresql+asyncpg://USER:PASS@HOST/slate?ssl=verify-full plus PGSSLROOTCERT.

# OIDC sign-in (Auth0). Unused when SLATE_AUTH=dev.
SLATE_AUTH=oidc
OIDC_ISSUER=https://YOUR-TENANT.us.auth0.com/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SLATE_PUBLIC_URL=http://localhost:8000
APP_SESSION_SECRET=
# Who may sign in: Auth0 subjects and/or verified emails, comma-separated.
SLATE_ALLOWED_USER_IDS=
SLATE_ALLOWED_EMAILS=you@example.com


# The sidebar assistant: an OpenRouter model id (ZDR routing only), or "stub" for tests.
AGENT_MODEL=openai/gpt-6-luna
OPENROUTER_API_KEY=
